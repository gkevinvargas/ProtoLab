          "min": 0.95,
          "max": 1.05
        },
        {
          "id": "voltaje-final",
          "type": "rc-measurement-range",
          "title": "Voltaje final",
          "description": "Al finalizar cinco constantes de tiempo, el capacitor debe aproximarse a 9 V.",
          "points": 5,
          "metric": "finalVoltageV",
          "min": 8.8,
          "max": 9.1
        }
      ]
    }
