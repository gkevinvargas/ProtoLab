{
  "schemaVersion": "1.0.0",
  "practice": {
    "id": "carga-capacitor-rc",
    "title": "Carga de un capacitor RC",
    "description": "Observa cómo un capacitor se carga a través de una resistencia conectada a una fuente de corriente continua.",
    "subject": "Electrónica básica",
    "difficulty": "principiante",
    "estimatedDurationMinutes": 20,
    "learningObjectives": [
      "Identificar la resistencia y el capacitor en un circuito RC.",
      "Comprender la constante de tiempo tau = R por C.",
      "Observar cómo el voltaje del capacitor aumenta gradualmente durante la carga."
    ],
    "instructions": [
      {
        "step": 1,
        "text": "Identifica la batería de 9 V, la resistencia de 10 kΩ y el capacitor de 100 µF."
      },
      {
        "step": 2,
        "text": "Comprueba que la batería, la resistencia y el capacitor formen un circuito cerrado en serie."
      },
      {
        "step": 3,
        "text": "Selecciona el modo Carga RC y ejecuta el análisis temporal."
      },
      {
        "step": 4,
        "text": "Observa cómo el voltaje del capacitor se aproxima gradualmente al voltaje de la fuente."
      }
    ],
    "allowedComponentTypes": [
      "bateria",
      "resistencia",
      "capacitor",
      "interruptor"
    ],
    "evaluation": {
      "passingScore": 70,
      "requiredAnalysis": "rc",
      "criteria": [
        {
          "id": "componentes",
          "type": "component-count",
          "title": "Componentes requeridos",
          "description": "Incluye una batería, una resistencia y un capacitor.",
          "points": 10,
          "expectedCounts": {
            "bateria": 1,
            "resistencia": 1,
            "capacitor": 1
          },
          "exact": true
        },
        {
          "id": "conexiones",
          "type": "connection-topology",
          "title": "Conexiones del circuito RC",
          "description": "Conecta la batería, la resistencia y el capacitor en serie para realizar la carga.",
          "points": 35,
