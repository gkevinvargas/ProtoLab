{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElectroLab Practice",
  "description": "Formato versionado para describir prácticas de ElectroLab.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "practice",
    "canvas",
    "components",
    "connections"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Versión semántica del formato de la práctica."
    },
    "practice": {
      "$ref": "#/$defs/practice"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "components": {
      "type": "array",
      "description": "Componentes colocados en el espacio de trabajo.",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "connections": {
      "type": "array",
      "description": "Relaciones entre terminales de componentes.",
      "items": {
        "$ref": "#/$defs/connection"
      }
    }
  },
  "$defs": {
    "componentType": {
      "type": "string",
      "enum": [
        "bateria",
        "resistencia",
        "led",
        "capacitor",
        "interruptor"
      ]
    },
    "practice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "subject",
        "difficulty",
        "estimatedDurationMinutes",
        "learningObjectives",
        "instructions",
        "allowedComponentTypes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "principiante",
            "intermedio",
            "avanzado"
          ]
        },
        "estimatedDurationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "learningObjectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instructions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "text"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "allowedComponentTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentType"
          }
        },
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "unit",
        "origin",
        "componentAnchor"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "unit": {
          "const": "px"
        },
        "origin": {
          "const": "top-left"
        },
        "componentAnchor": {
          "const": "center-top"
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "polarity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "polarity": {
          "type": "string",
          "enum": [
            "positive",
            "negative",
            "neutral"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "reference",
        "value",
        "unit",
        "position",
        "terminals"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "type": {
          "$ref": "#/$defs/componentType"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 8
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "terminals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/terminal"
            },
            {
              "$ref": "#/$defs/terminal"
            }
          ],
          "items": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "bateria"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "const": "V"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resistencia"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "Ω",
                  "kΩ",
                  "MΩ"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "led"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "const": "V"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capacitor"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "pF",
                  "nF",
                  "µF"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "interruptor"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "enum": [
                  "abierto",
                  "cerrado"
                ]
              },
              "unit": {
                "const": ""
              }
            }
          }
        }
      ]
    },
    "terminalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "terminalId"
      ],
      "properties": {
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "terminalId": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "from": {
          "$ref": "#/$defs/terminalReference"
        },
        "to": {
          "$ref": "#/$defs/terminalReference"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passingScore",
        "requiredAnalysis",
        "criteria"
      ],
      "properties": {
        "passingScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "requiredAnalysis": {
          "type": "string",
          "enum": [
            "dc",
            "rc"
          ]
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points",
                  "expectedCounts"
                ],
                "properties": {
                  "type": {
                    "const": "component-count"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "expectedCounts": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "properties": {
                      "bateria": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "resistencia": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "led": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "capacitor": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "interruptor": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "exact": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points",
                  "reference",
                  "expectedValue",
                  "unit"
                ],
                "properties": {
                  "type": {
                    "const": "component-value"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expectedValue": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tolerance": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points",
                  "expectedConnections"
                ],
                "properties": {
                  "type": {
                    "const": "connection-topology"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "expectedConnections": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "from",
                        "to"
                      ],
                      "properties": {
                        "from": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "reference",
                            "terminalId"
                          ],
                          "properties": {
                            "reference": {
                              "type": "string",
                              "minLength": 1
                            },
                            "terminalId": {
                              "type": "string",
                              "enum": [
                                "left",
                                "right"
                              ]
                            }
                          }
                        },
                        "to": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "reference",
                            "terminalId"
                          ],
                          "properties": {
                            "reference": {
                              "type": "string",
                              "minLength": 1
                            },
                            "terminalId": {
                              "type": "string",
                              "enum": [
                                "left",
                                "right"
                              ]
                            }
                          }
                        }
                      }
                    }
                  },
                  "exact": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points"
                ],
                "properties": {
                  "type": {
                    "const": "analysis-status"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points",
                  "reference",
                  "expectedState"
                ],
                "properties": {
                  "type": {
                    "const": "dc-state"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "expectedState": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points",
                  "reference",
                  "metric",
                  "min",
                  "max"
                ],
                "properties": {
                  "type": {
                    "const": "dc-measurement-range"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "metric": {
                    "type": "string",
                    "enum": [
                      "voltageV",
                      "currentA",
                      "powerW"
                    ]
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points",
                  "expectedMode"
                ],
                "properties": {
                  "type": {
                    "const": "rc-mode"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "expectedMode": {
                    "type": "string",
                    "enum": [
                      "charge",
                      "discharge"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id",
                  "title",
                  "description",
                  "points",
                  "metric",
                  "min",
                  "max"
                ],
                "properties": {
                  "type": {
                    "const": "rc-measurement-range"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "points": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "metric": {
                    "type": "string",
                    "enum": [
                      "timeConstantSeconds",
                      "finalVoltageV"
                    ]
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
